{
  "name": "jobfit-ai",
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "#*": "./agent/*",
    "#lib/*": "./agent/lib/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "build": "npm run build:docs && next build",
    "build:docs": "npm run build --prefix website && node scripts/copy-docs.mjs",
    "dev": "next dev",
    "dev:docs": "npm run start --prefix website -- --port 3001 --host 0.0.0.0",
    "start": "next start",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "skills:sync": "node scripts/sync-agent-skills.mjs",
    "ui:add": "npx shadcn@latest add",
    "build:eve": "eve build",
    "dev:eve": "eve dev",
    "start:eve": "eve start"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.50",
    "@clerk/nextjs": "^7.8.2",
    "@clerk/ui": "^1.30.8",
    "@embedpdf/react-pdf-viewer": "^2.15.0",
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-use-controllable-state": "1.2.2",
    "@shikijs/core": "4.1.0",
    "@shikijs/engine-javascript": "4.1.0",
    "@shikijs/engine-oniguruma": "4.1.0",
    "@streamdown/cjk": "1.0.3",
    "@streamdown/code": "1.1.1",
    "@streamdown/math": "1.0.2",
    "@streamdown/mermaid": "1.0.2",
    "@tailwindcss/postcss": "4.3.0",
    "@tiptap/pm": "^3.30.5",
    "@tiptap/react": "^3.30.5",
    "@tiptap/starter-kit": "^3.30.5",
    "@types/pdf-parse": "^1.1.5",
    "@vercel/connect": "0.2.2",
    "ai": "^7.0.83",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "convex": "^1.45.0",
    "docx": "^9.7.1",
    "effect": "^3.22.1",
    "eve": "^0.19.0",
    "jspdf": "^4.2.1",
    "lucide-react": "1.16.0",
    "mammoth": "^1.12.1",
    "motion": "12.40.0",
    "nanoid": "5.1.11",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "pdf-parse": "^2.4.5",
    "radix-ui": "1.4.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.86.0",
    "recharts": "^3.10.1",
    "sanitize-html": "^2.17.7",
    "shiki": "4.1.0",
    "sonner": "^2.0.8",
    "streamdown": "2.5.0",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.0",
    "use-stick-to-bottom": "1.1.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@types/sanitize-html": "^2.16.1",
    "convex-test": "^0.0.54",
    "microsandbox": "^0.5.10",
